{
  "name": "internetdata",
  "version": "3.1.12",
  "description": "List InternetData's IP and ASN databases, your license for each, what one holds, and its digests.",
  "mcpServers": {
    "internetdata": {
      "command": "npx",
      "args": ["-y", "internetdata-mcp"]
    }
  },
  "settings": [
    {
      "name": "API key",
      "description": "Your InternetData API key",
      "envVar": "INTERNETDATA_API_KEY",
      "sensitive": true
    }
  ]
}
